    </div>
</section>

<!-- Student Registration Modal -->
<div id="studentRegisterModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" id="closeModal">&times;</span>
        <h2>Student Registration</h2>

       
        

        <form action="/register-student" method="POST">
            <label for="name">Student Name:</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>

            <label for="phone">Mobile Number:</label>
            <input type="text" id="phone" name="phone" required pattern="[0-9]{10}" placeholder="Enter 10-digit mobile number">

            <label for="parentName">Parent's Name:</label>
            <input type="text" id="parentName" name="parentName" required>

            <label for="parentContact">Parent's Contact:</label>
            <input type="text" id="parentContact" name="parentContact" required pattern="[0-9]{10}" placeholder="Enter 10-digit parent contact">

            <label for="deviceId">Device ID:</label>
            <input type="text" id="deviceId" name="deviceId" required placeholder="Enter your Device ID">

            <label for="schoolName">School Name:</label>
            <input type="text" id="schoolName" name="schoolName" required>

            <button type="submit" class="btn btn-success">Submit</button>
        </form>
    </div>
</div>

 <!-- Success/error msg box -->
<div id="messageBox" class="message" style="display: none;"></div>


<script>
    document.querySelector("form").addEventListener("submit", async function(event) {
        event.preventDefault(); // Form reload hone se roko

        let formData = new FormData(this);

        try {
            let response = await fetch("/register-student", {
                method: "POST",
                body: formData
            });

            let result = await response.json(); // JSON response lo

            let messageBox = document.getElementById("messageBox");

            if (response.ok) {
                messageBox.innerText = "Student registered successfully! Waiting for Admin Approval.";
                messageBox.style.backgroundColor = "#4CAF50"; 
            } else {
                messageBox.innerText = " Registration failed: " + result.message;
                messageBox.style.backgroundColor = "#f44336"; 
            }

            messageBox.style.display = "block"; // msg show karo
            document.getElementById("studentRegisterModal").style.display = "none"; //  close Modal
            this.reset(); //  reset Form

            // msg 5 sec baad hide 
            setTimeout(() => {
                messageBox.style.display = "none";
            }, 5000);

        } catch (error) {
            let messageBox = document.getElementById("messageBox");
            messageBox.innerText = " Error submitting the form.";
            messageBox.style.backgroundColor = "#f44336"; // Red
            messageBox.style.display = "block";
        }
    });
</script>

<script>
    // Modal Open and Close
    document.getElementById("openStudentRegisterModal").addEventListener("click", function() {
        document.getElementById("studentRegisterModal").style.display = "block";
    });

    document.getElementById("closeModal").addEventListener("click", function() {
        document.getElementById("studentRegisterModal").style.display = "none";
    });
</script>



