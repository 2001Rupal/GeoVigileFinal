<% layout('boilerplate') -%>

<main class="hero">
    <div class="hero-content">
        <h1>Welcome to <span class="highlight">GeoVigil</span></h1>
        <h2>Advanced Geofencing & Security Alerts</h2>

        <a href="/register" class="btn">Get Started</a>
        <a href="/login" class="btn btn-secondary">Login</a>
        <a href="/student-form" class="btn btn-primary">Register Student</a>
    </div>
</main>

<section class="features">
    <div class="feature">
        <h3>📍 Real-Time Tracking</h3>
        <p>Monitor and track locations effortlessly.</p>
    </div>
    <div class="feature">
        <h3> Geofencing Alerts</h3>
